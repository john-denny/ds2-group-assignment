## Basys 3 Rev B pin constraints for the main module.

## 100 MHz system clock
set_property LOC W5 [get_ports clk]
set_property IOSTANDARD LVCMOS33 [get_ports clk]
create_clock -add -name sys_clk_pin -period 10.00 -waveform {0 5} [get_ports clk]

## Slide switches: input_bits[0] is SW0, through input_bits[15] on SW15.
set_property LOC V17 [get_ports {input_bits[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {input_bits[0]}]
set_property LOC V16 [get_ports {input_bits[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {input_bits[1]}]
set_property LOC W16 [get_ports {input_bits[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {input_bits[2]}]
set_property LOC W17 [get_ports {input_bits[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {input_bits[3]}]
set_property LOC W15 [get_ports {input_bits[4]}]
set_property IOSTANDARD LVCMOS33 [get_ports {input_bits[4]}]
set_property LOC V15 [get_ports {input_bits[5]}]
set_property IOSTANDARD LVCMOS33 [get_ports {input_bits[5]}]
set_property LOC W14 [get_ports {input_bits[6]}]
set_property IOSTANDARD LVCMOS33 [get_ports {input_bits[6]}]
set_property LOC W13 [get_ports {input_bits[7]}]
set_property IOSTANDARD LVCMOS33 [get_ports {input_bits[7]}]
set_property LOC V2 [get_ports {input_bits[8]}]
set_property IOSTANDARD LVCMOS33 [get_ports {input_bits[8]}]
set_property LOC T3 [get_ports {input_bits[9]}]
set_property IOSTANDARD LVCMOS33 [get_ports {input_bits[9]}]
set_property LOC T2 [get_ports {input_bits[10]}]
set_property IOSTANDARD LVCMOS33 [get_ports {input_bits[10]}]
set_property LOC R3 [get_ports {input_bits[11]}]
set_property IOSTANDARD LVCMOS33 [get_ports {input_bits[11]}]
set_property LOC W2 [get_ports {input_bits[12]}]
set_property IOSTANDARD LVCMOS33 [get_ports {input_bits[12]}]
set_property LOC U1 [get_ports {input_bits[13]}]
set_property IOSTANDARD LVCMOS33 [get_ports {input_bits[13]}]
set_property LOC T1 [get_ports {input_bits[14]}]
set_property IOSTANDARD LVCMOS33 [get_ports {input_bits[14]}]
set_property LOC R2 [get_ports {input_bits[15]}]
set_property IOSTANDARD LVCMOS33 [get_ports {input_bits[15]}]

## LEDs: device_led[0] is LD0, through device_led[15] on LD15.
set_property LOC U16 [get_ports {device_led[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {device_led[0]}]
set_property LOC E19 [get_ports {device_led[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {device_led[1]}]
set_property LOC U19 [get_ports {device_led[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {device_led[2]}]
set_property LOC V19 [get_ports {device_led[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {device_led[3]}]
set_property LOC W18 [get_ports {device_led[4]}]
set_property IOSTANDARD LVCMOS33 [get_ports {device_led[4]}]
set_property LOC U15 [get_ports {device_led[5]}]
set_property IOSTANDARD LVCMOS33 [get_ports {device_led[5]}]
set_property LOC U14 [get_ports {device_led[6]}]
set_property IOSTANDARD LVCMOS33 [get_ports {device_led[6]}]
set_property LOC V14 [get_ports {device_led[7]}]
set_property IOSTANDARD LVCMOS33 [get_ports {device_led[7]}]
set_property LOC V13 [get_ports {device_led[8]}]
set_property IOSTANDARD LVCMOS33 [get_ports {device_led[8]}]
set_property LOC V3 [get_ports {device_led[9]}]
set_property IOSTANDARD LVCMOS33 [get_ports {device_led[9]}]
set_property LOC W3 [get_ports {device_led[10]}]
set_property IOSTANDARD LVCMOS33 [get_ports {device_led[10]}]
set_property LOC U3 [get_ports {device_led[11]}]
set_property IOSTANDARD LVCMOS33 [get_ports {device_led[11]}]
set_property LOC P3 [get_ports {device_led[12]}]
set_property IOSTANDARD LVCMOS33 [get_ports {device_led[12]}]
set_property LOC N3 [get_ports {device_led[13]}]
set_property IOSTANDARD LVCMOS33 [get_ports {device_led[13]}]
set_property LOC P1 [get_ports {device_led[14]}]
set_property IOSTANDARD LVCMOS33 [get_ports {device_led[14]}]
set_property LOC L1 [get_ports {device_led[15]}]
set_property IOSTANDARD LVCMOS33 [get_ports {device_led[15]}]

## Seven-segment display: segments[0] is a through segments[6] as g.
set_property LOC W7 [get_ports {segments[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {segments[0]}]
set_property LOC W6 [get_ports {segments[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {segments[1]}]
set_property LOC U8 [get_ports {segments[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {segments[2]}]
set_property LOC V8 [get_ports {segments[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {segments[3]}]
set_property LOC U5 [get_ports {segments[4]}]
set_property IOSTANDARD LVCMOS33 [get_ports {segments[4]}]
set_property LOC V5 [get_ports {segments[5]}]
set_property IOSTANDARD LVCMOS33 [get_ports {segments[5]}]
set_property LOC U7 [get_ports {segments[6]}]
set_property IOSTANDARD LVCMOS33 [get_ports {segments[6]}]
set_property LOC V7 [get_ports decimal]
set_property IOSTANDARD LVCMOS33 [get_ports decimal]
set_property LOC U2 [get_ports {enable[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {enable[0]}]
set_property LOC U4 [get_ports {enable[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {enable[1]}]
set_property LOC V4 [get_ports {enable[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {enable[2]}]
set_property LOC W4 [get_ports {enable[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {enable[3]}]

## Center button resets; up button toggles encode/decode mode.
set_property LOC U18 [get_ports rst]
set_property IOSTANDARD LVCMOS33 [get_ports rst]
set_property LOC T18 [get_ports mode_button]
set_property IOSTANDARD LVCMOS33 [get_ports mode_button]
